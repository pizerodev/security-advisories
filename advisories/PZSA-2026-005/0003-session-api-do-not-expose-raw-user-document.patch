--- a/admin/server/api/session/get.js
+++ b/admin/server/api/session/get.js
@@ -1,5 +1,16 @@
 function get (req, res) {
-	return res.json({ user: req.user });
+	var keystone = req.keystone;
+	var user = req.user;
+	if (!user) {
+		return res.json({ user: null });
+	}
+	// Serialise through List.getData() so field types control what is exposed
+	// (e.g. password fields become a boolean) instead of returning the raw
+	// mongoose document, which includes the password hash.
+	var UserList = keystone.list(keystone.get('user model'));
+	return res.json({
+		user: UserList ? UserList.getData(user) : { id: user.id },
+	});
 }
 
 module.exports = get;
